# SLO burn-rate alarms (261113-trading-real-bot Observability Setup, Q3; slo-config.md). Two windows per SLO, both on a
# 30-day budget: 2% of the budget burned in 1 hour (burn rate 14.4) and 5% in 6 hours (burn rate 6). Both fire long
# before the SLO itself is broken (operation phase rule: thresholds below the SLO breach).
#
#   burn rate      = budget share x 720 h / window hours
#   bad ratio max  = burn rate x (1 - SLO target)
#
# - API availability, 99.5% / 30 days (U1:NFR4.1): 5xx answers of the api target group over its requests, read at the
#   load balancer (closest to the user). A window with fewer than 10 requests counts as healthy (pilot traffic).
# - TxSigner availability, 99.5% / 30 days (U1:NFR4.1): the TxSigner has no load balancer, so the SLI is time based: a
#   slot of 240 s (two reads of the agent) is bad when the heartbeat of the TxSigner is missing.
# - Freshness of the market data, 99% / 30 days (U2:NFR4.1, marketdata_price_fresh_minute): a slot of 240 s is bad when the
#   oldest price is older than 60 s, or when the worker published nothing (missing = stale).
#
# The time-based alarms evaluate one 0/1 point per slot of 240 s (the agent reads every 120 s, so a slot always holds
# two reads) and alarm on N bad slots out of the window (M of N): 15 slots in 1 hour, 90 in 6 hours.

variable "api_load_balancer_arn_suffix" {
  description = "arn_suffix of the load balancer (dimension LoadBalancer of AWS/ApplicationELB)"
  type        = string
}

variable "api_target_group_arn_suffix" {
  description = "arn_suffix of the api target group (dimension TargetGroup of AWS/ApplicationELB)"
  type        = string
}

locals {
  slo_budget_hours = 720

  slo_windows = {
    "1h" = { seconds = 3600, budget_share = 0.02, severity = "high" }
    "6h" = { seconds = 21600, budget_share = 0.05, severity = "medium" }
  }

  # Written as literals so the alarm, slo-config.md and alarms.md show the same numbers; the offline test recomputes
  # them from the formula above.
  slo_targets = {
    availability = 0.995
    freshness    = 0.99
  }
  slo_bad_ratio = {
    availability = { "1h" = 0.072, "6h" = 0.03 }
    freshness    = { "1h" = 0.144, "6h" = 0.06 }
  }
  # Slots of 240 s (two reads of the agent). Bad slots allowed in the window before the alarm:
  # ceil(bad ratio x slots of the window).
  slo_slot_seconds = 240
  slo_bad_slots = {
    availability = { "1h" = 2, "6h" = 3 }
    freshness    = { "1h" = 3, "6h" = 6 }
  }
}

resource "aws_cloudwatch_metric_alarm" "slo_api_availability_burn" {
  for_each = local.slo_windows

  alarm_name          = "${var.name}-slo-api-availability-burn-${each.key}"
  alarm_description   = "Q3/U1:NFR4.1: the api burned ${each.value.budget_share * 100}% of its 30-day error budget (SLO 99.5%) in ${each.key}; 5xx ratio above ${local.slo_bad_ratio.availability[each.key]} (${each.value.severity})."
  evaluation_periods  = 1
  threshold           = local.slo_bad_ratio.availability[each.key]
  comparison_operator = "GreaterThanThreshold"
  treat_missing_data  = "notBreaching"
  alarm_actions       = [var.alarm_topic_arn]

  metric_query {
    id          = "error_ratio"
    expression  = "IF(requests >= 10, (FILL(target_5xx, 0) + FILL(elb_5xx, 0)) / requests, 0)"
    label       = "api 5xx ratio (${each.key})"
    return_data = true
  }

  metric_query {
    id = "requests"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "RequestCount"
      dimensions  = { LoadBalancer = var.api_load_balancer_arn_suffix, TargetGroup = var.api_target_group_arn_suffix }
      stat        = "Sum"
      period      = each.value.seconds
    }
  }

  metric_query {
    id = "target_5xx"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "HTTPCode_Target_5XX_Count"
      dimensions  = { LoadBalancer = var.api_load_balancer_arn_suffix, TargetGroup = var.api_target_group_arn_suffix }
      stat        = "Sum"
      period      = each.value.seconds
    }
  }

  # 5xx generated by the load balancer itself (502/503/504, no healthy target). It exists per load balancer only, so
  # the 5xx of the web and the admin count here too: conservative.
  metric_query {
    id = "elb_5xx"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "HTTPCode_ELB_5XX_Count"
      dimensions  = { LoadBalancer = var.api_load_balancer_arn_suffix }
      stat        = "Sum"
      period      = each.value.seconds
    }
  }
}

resource "aws_cloudwatch_metric_alarm" "slo_txsigner_availability_burn" {
  for_each = local.slo_windows

  alarm_name          = "${var.name}-slo-txsigner-availability-burn-${each.key}"
  alarm_description   = "Q3/U1:NFR4.1: the TxSigner burned ${each.value.budget_share * 100}% of its 30-day budget (SLO 99.5%) in ${each.key}; ${local.slo_bad_slots.availability[each.key]} or more slots of 240 s without heartbeat (${each.value.severity})."
  evaluation_periods  = each.value.seconds / local.slo_slot_seconds
  datapoints_to_alarm = local.slo_bad_slots.availability[each.key]
  threshold           = 1
  comparison_operator = "GreaterThanOrEqualToThreshold"
  treat_missing_data  = "breaching"
  alarm_actions       = [var.alarm_topic_arn]

  metric_query {
    id          = "bad_minute"
    expression  = "IF(FILL(heartbeat, 0) < 1, 1, 0)"
    label       = "TxSigner slot of 240 s without heartbeat"
    return_data = true
  }

  metric_query {
    id = "heartbeat"
    metric {
      namespace   = local.app_metrics_namespace
      metric_name = "process_uptime_seconds"
      dimensions  = { job = "txsigner" }
      stat        = "SampleCount"
      period      = local.slo_slot_seconds
    }
  }
}

resource "aws_cloudwatch_metric_alarm" "slo_freshness_burn" {
  for_each = local.slo_windows

  alarm_name          = "${var.name}-slo-freshness-burn-${each.key}"
  alarm_description   = "Q3/U2:NFR4.1: the market data burned ${each.value.budget_share * 100}% of its 30-day budget (SLO 99%) in ${each.key}; ${local.slo_bad_slots.freshness[each.key]} or more slots of 240 s with the oldest price above 60 s (${each.value.severity})."
  evaluation_periods  = each.value.seconds / local.slo_slot_seconds
  datapoints_to_alarm = local.slo_bad_slots.freshness[each.key]
  threshold           = 1
  comparison_operator = "GreaterThanOrEqualToThreshold"
  treat_missing_data  = "breaching"
  alarm_actions       = [var.alarm_topic_arn]

  metric_query {
    id          = "stale_minute"
    expression  = "IF(FILL(age, 3600) > 60, 1, 0)"
    label       = "slot of 240 s with the oldest price above 60 s"
    return_data = true
  }

  metric_query {
    id = "age"
    metric {
      namespace   = local.app_metrics_namespace
      metric_name = "marketdata_oldest_price_age_seconds"
      stat        = "Maximum"
      period      = local.slo_slot_seconds
    }
  }
}

output "slo_math" {
  description = "Targets, windows and thresholds of the burn-rate alarms (offline test recomputes them)"
  value = {
    budget_hours = local.slo_budget_hours
    windows      = local.slo_windows
    targets      = local.slo_targets
    bad_ratio    = local.slo_bad_ratio
    slot_seconds = local.slo_slot_seconds
    bad_slots    = local.slo_bad_slots
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!--
  JSON logs on stdout (observability-design.md): timestamp (UTC), level, component, message, correlationId.
  Every string value passes through the Base58 masker: addresses and signatures keep only the first six and the last
  four characters (security-design.md "Dados e logs", NFR1.10).
-->
<configuration>
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeContext>false</includeContext>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <logger>component</logger>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
                <thread>[ignore]</thread>
            </fieldNames>
            <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <valueMasker class="com.memetrade.txsigner.infra.logging.Base58ValueMasker"/>
            </jsonGeneratorDecorator>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>

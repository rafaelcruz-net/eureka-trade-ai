# Copy to .env and fill in local values. .env is ignored by git; never commit real values.
# Every variable from the U1 infrastructure specification is listed here without a value.

# PostgreSQL superuser (container bootstrap only).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database logins, all created by the db-bootstrap service (infra/postgres/bootstrap); none is a superuser.
# Schema owner: used ONLY by the db-migrate service (Liquibase); never given to the api.
DB_OWNER_USER=
DB_OWNER_PASSWORD=
# Application login (data only, no DDL).
DB_USER=
DB_PASSWORD=
# Retention login (member of audit_retention: read and delete audit_event only), used only by the audit purge.
DB_RETENTION_USER=
DB_RETENTION_PASSWORD=

# Months the audit trail keeps an event (BR3.1). Empty means 12; the api refuses to start below 12.
AUDIT_RETENTION_MONTHS=

# Tag of the locally built images (memetrade-api, memetrade-web). Empty means "local".
IMAGE_TAG=

# HMAC key that signs the 15-minute access token (at least 32 random bytes, base64).
# Never logged. CI generates an ephemeral value per run.
ACCESS_TOKEN_SIGNING_KEY=

# Origin of the guest web app allowed by CORS (for example http://localhost:3000).
GUEST_APP_ORIGIN=

# Origin of the API, used only by the Next.js server to build the CSP and the client config.
API_ORIGIN=

# Trusted reverse proxies; empty in the local environment (X-Forwarded-For is ignored).
TRUSTED_PROXIES=

# Comma-separated public wallet addresses of administrators (not secrets; BR1.5).
ADMIN_WALLET_ADDRESSES=

# --- U8 Administration and feedback. Not a secret.
# Origin of the administrator app accepted by the administrative CORS policy [http://localhost:3001]. One http(s)
# origin, never a wildcard (the api refuses to start otherwise). It must be on the same site as the API and the guest
# app (SameSite=Strict refresh cookie): locally localhost on port 3001.
ADMIN_APP_ORIGIN=

# --- U4 Discovery and assessment. None is a secret; empty means the default in brackets. A value out of range stops
# the api with a message that names the variable.
# Main connection pool, 10 to 50 [20].
DB_POOL_MAX_SIZE=
# Scheduler threads of the api, 16 to 32 [16] (one per scheduled job: 12 of U1 to U7, the U6 purge, the U5 live
# channel poller and the two jobs of U8, kill switch reconciliation and feedback purge). The worker (U5) has its own
# fixed 4 threads and 14 connections in docker-compose.yml.
SCHEDULER_POOL_SIZE=
# Active simulated sources, sim-a and/or sim-b [sim-a,sim-b]. No real source before G0 (C-06).
MARKET_SOURCES=
# Collection interval of each source, 5s to 60s [30s].
MARKET_COLLECTION_INTERVAL=
# Tokens per simulated source, 50 to 10000 [200]; the load test exports 2000.
MARKET_SIMULATED_TOKENS_PER_SOURCE=
# Fixed seed of the simulated sources [42]; never random by default.
MARKET_SIMULATED_SEED=
# Divergence tolerance per field in percentage points, 0 to 100 [5.0000].
MARKET_DIVERGENCE_TOLERANCE_PERCENT=
# Requests per person and route in 60 s, 1 to 10000 [60]; the load test raises it.
SCANNER_RATE_LIMIT_PER_MINUTE=

# --- Set only by infra/docker-compose.test.yml and scripts/verify.sh; never in docker-compose.yml ---
# SPRING_PROFILES_ACTIVE=            # test or test,loadtest
# SMOKE_BETA_WALLET_ADDRESS=         # public address of the generated smoke wallet
# LOGIN_RATE_LIMIT_PER_MINUTE=       # default 10; raised only by the loadtest profile

# Copy to .env and fill in local values. .env is ignored by git; never commit real values.
# Every variable from the U1 infrastructure specification is listed here without a value.

# PostgreSQL superuser (container bootstrap only).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database logins, all created by the db-bootstrap service (infra/postgres/bootstrap); none is a superuser.
# Schema owner: used ONLY by the db-migrate service (Liquibase); never given to the api.
DB_OWNER_USER=
DB_OWNER_PASSWORD=
# Application login (data only, no DDL).
DB_USER=
DB_PASSWORD=
# Retention login (member of audit_retention: read and delete audit_event only), used only by the audit purge.
DB_RETENTION_USER=
DB_RETENTION_PASSWORD=

# Months the audit trail keeps an event (BR3.1). Empty means 12; the api refuses to start below 12.
AUDIT_RETENTION_MONTHS=

# Tag of the locally built images (memetrade-api, memetrade-web). Empty means "local".
IMAGE_TAG=

# HMAC key that signs the 15-minute access token (at least 32 random bytes, base64).
# Never logged. CI generates an ephemeral value per run.
ACCESS_TOKEN_SIGNING_KEY=

# u2-retention: key of the HMAC-SHA-256 that replaces the wallet addresses in the audit trail (at least 32 bytes; for
# example 64 random hexadecimal characters). Required by the api and the worker: they do not start without it. Never
# logged nor shown by the actuator. The same key all through the beta (changing it breaks the correlation of older
# events; only after a leak, see the incident runbook). In the cloud it comes from the secrets manager.
MEMETRADE_AUDIT_WALLET_HMAC_KEY=

# Origin of the guest web app allowed by CORS (for example http://localhost:3000).
GUEST_APP_ORIGIN=

# Origin of the API, used only by the Next.js server to build the CSP and the client config.
API_ORIGIN=

# Trusted reverse proxies; empty in the local environment (X-Forwarded-For is ignored).
TRUSTED_PROXIES=

# Comma-separated public wallet addresses of administrators (not secrets; BR1.5).
ADMIN_WALLET_ADDRESSES=

# --- U8 Administration and feedback. Not a secret.
# Origin of the administrator app accepted by the administrative CORS policy [http://localhost:3001]. One http(s)
# origin, never a wildcard (the api refuses to start otherwise). It must be on the same site as the API and the guest
# app (SameSite=Strict refresh cookie): locally localhost on port 3001.
ADMIN_APP_ORIGIN=

# --- U4 Discovery and assessment. None is a secret; empty means the default in brackets. A value out of range stops
# the api with a message that names the variable.
# Main connection pool, 10 to 50 [20].
DB_POOL_MAX_SIZE=
# Scheduler threads of the api, 21 to 32 [21] (one per scheduled job: 12 of U1 to U7, the U6 purge, the U5 live
# channel poller, the two jobs of U8, kill switch reconciliation and feedback purge, the two purges of u2-retention,
# login challenges and sessions, and the three jobs of u4-data-requests, request timers, request purge and the
# refresher of the request counts). The worker (U5) has its own fixed 4 threads and 14 connections in
# docker-compose.yml.
SCHEDULER_POOL_SIZE=
# Active simulated sources, sim-a and/or sim-b [sim-a,sim-b]. No real source before G0 (C-06).
MARKET_SOURCES=
# Collection interval of each source, 5s to 60s [30s].
MARKET_COLLECTION_INTERVAL=
# Tokens per simulated source, 50 to 10000 [200]; the load test exports 2000.
MARKET_SIMULATED_TOKENS_PER_SOURCE=
# Fixed seed of the simulated sources [42]; never random by default.
MARKET_SIMULATED_SEED=
# Divergence tolerance per field in percentage points, 0 to 100 [5.0000].
MARKET_DIVERGENCE_TOLERANCE_PERCENT=
# Requests per person and route in 60 s, 1 to 10000 [60]; the load test raises it.
SCANNER_RATE_LIMIT_PER_MINUTE=

# --- u1-legal-documents (legal documents and local network). None is a secret; empty means the default in brackets.
# Deployment fields of the privacy policy; empty reads "a definir" and the current version is not publishable.
MEMETRADE_LEGAL_STORAGE_LOCATION=
MEMETRADE_LEGAL_INTERNATIONAL_TRANSFER=
MEMETRADE_LEGAL_DPO_EMAIL=
# A non-legacy version is activated only when publishable (true only in production) [false].
MEMETRADE_LEGAL_REQUIRE_PUBLISHABLE=
# CIDR list exempt from the 60 requests per minute of /api/v1/legal/**, compared only with the direct peer
# [the apps sub-range]. Never the bridge gateway, a load balancer or a proxy.
MEMETRADE_LEGAL_RATE_LIMIT_INTERNAL_NETWORKS=
# Origin the web and admin SERVERS use to read the API inside the Compose network [http://api:8080]; read only on the
# server, never sent to the browser.
API_INTERNAL_ORIGIN=
# Fixed range of the Compose network [172.28.0.0/16], its gateway [172.28.0.1], the range of the containers without a
# fixed address [172.28.0.0/24], the sub-range of the web and admin apps [172.28.1.0/24] and their addresses
# [172.28.1.10, 172.28.1.11]. On "Pool overlaps", change them together; the first `up` with the range needs a
# `docker compose down` first.
COMPOSE_SUBNET=
COMPOSE_GATEWAY=
COMPOSE_DYNAMIC_RANGE=
COMPOSE_APPS_SUBNET=
COMPOSE_WEB_IPV4=
COMPOSE_ADMIN_IPV4=

# --- Set only by infra/docker-compose.test.yml and scripts/verify.sh; never in docker-compose.yml ---
# SPRING_PROFILES_ACTIVE=            # test or test,loadtest
# SMOKE_BETA_WALLET_ADDRESS=         # public address of the generated smoke wallet
# LOGIN_RATE_LIMIT_PER_MINUTE=       # default 10; raised only by the loadtest profile

# --- 261113-trading-real-bot U1: REAL of the bot wallet. Set only by infra/docker-compose.real.yml and
# scripts/verify.sh (generated per run); the REAL stays OFF without them (memetrade.real.enabled=false). ---
# TxSigner database: own schema "txsigner", owner login (migration only) and application login.
# TXSIGNER_DB_OWNER_USER=
# TXSIGNER_DB_OWNER_PASSWORD=
# TXSIGNER_DB_USER=
# TXSIGNER_DB_PASSWORD=
# Service credential between the api/worker and the TxSigner (NFR1.5); in the cloud it lives in the secrets manager.
# TXSIGNER_SERVICE_TOKEN=
# TXSIGNER_SERVICE_TOKEN_PREVIOUS=
# TxSigner KMS: endpoint (empty = AWS default; only the kms-sim locally), anchor HMAC key and production checks.
# TXSIGNER_KMS_ENDPOINT=
# TXSIGNER_KMS_HMAC_KEY_ID=
# TXSIGNER_KMS_KEY_POLICY=
# TXSIGNER_AWS_ACCOUNT_ID=
# TXSIGNER_ALLOWED_KMS_ENDPOINTS=
# TXSIGNER_CREDENTIAL_SOURCE=
# TXSIGNER_CREDENTIAL_SECRET_ID=
# TXSIGNER_NETWORK=
# TXSIGNER_REAL_ENABLED=
# api and worker: REAL flag, network, TxSigner address and token, RPC providers (worker only).
# MEMETRADE_REAL_ENABLED=
# MEMETRADE_REAL_NETWORK=
# MEMETRADE_REAL_SEED_TEST_RELEASE=
# MEMETRADE_TXSIGNER_URL=
# MEMETRADE_TXSIGNER_TOKEN=
# MEMETRADE_RPC_PRIMARY_URL=
# MEMETRADE_RPC_SECONDARY_URL=

# --- 261113-trading-real-bot U2: the real market source coingecko (MARKET_SOURCES=coingecko in the api and the
# worker). The local environment, the tests and scripts/verify.sh keep MARKET_SOURCES=sim-a,sim-b and never call the
# provider. Only the WORKER reads the key (secret coingecko-api-key in the cloud); never logged, never in the browser,
# never a public variable of the web app. With MEMETRADE_REAL_ENABLED=true outside the test and local profiles, the api and the
# worker refuse to start with sim-a or sim-b. ---
# COINGECKO_API_KEY=
# COINGECKO_BASE_URL=                # empty means https://pro-api.coingecko.com/api/v3 (CoinGecko hosts only)

# --- 261113-trading-real-bot U3: limits of the REAL risk barrier (memetrade.real.risk.* in application.yml, read by
# the api and the worker). Leave them unset: the defaults are the limits of the requirements. Outside the test and
# local profiles a LOOSER value (higher percentage, more buys, longer age or reservation) refuses the start; a value out
# of range refuses it in every profile; stricter values are accepted. A change needs a new deployment. ---
# MEMETRADE_REAL_RISK_ORDER_MAX_BPS=        # default 1000 (10% of the cap per buy), range 1 to 1000
# MEMETRADE_REAL_RISK_DAILY_LOSS_MAX_BPS=   # default 2000 (20% of loss pauses the day), range 1 to 2000
# MEMETRADE_REAL_RISK_DAILY_BUYS_MAX=       # default 20 approved buys per bot and UTC day, range 1 to 20
# MEMETRADE_REAL_RISK_SIGNAL_MAX_AGE=       # default 60s, range 5s to 60s
# MEMETRADE_REAL_RISK_RESERVATION_TTL=      # default 5m, range 1m to 5m
